# Google, set one of the two
GOOGLE_CREDENTIALS_PATH=/home/youruser/stockfolio/credentials.json
# GOOGLE_CREDENTIALS_JSON={"type":"service_account",...}
SHEET_ID=your_sheet_id_here

# Weekly snapshots, needed for week-over-week deltas
HISTORY_DIR=./history

# Broker CSVs, used by cmd/import_csv only
IMPORTS_DIR=./imports

# HTTP handler (cmd/server)
PORT=8080

# Discord
DISCORD_ENABLED=false
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxx/yyy
